{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SignWithOwnKeyOnly",
      "Effect": "Allow",
      "Action": "kms:Sign",
      "Resource": "arn:aws:kms:ap-southeast-1:ACCOUNT_ID:key/MSU_KEY_ID"
    },
    {
      "Sid": "ReadIssuerRegistry",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:ap-southeast-1:ACCOUNT_ID:table/TrustCert-Issuers"
    },
    {
      "Sid": "WriteAndRevokeCertificates",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:ACCOUNT_ID:table/TrustCert-Certificates"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-1:ACCOUNT_ID:*"
    }
  ]
}
