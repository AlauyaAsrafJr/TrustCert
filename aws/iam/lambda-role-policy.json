{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustCertTables",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-1:ACCOUNT_ID:table/TrustCert-Certificates",
        "arn:aws:dynamodb:ap-southeast-1:ACCOUNT_ID:table/TrustCert-Issuers"
      ]
    },
    {
      "Sid": "SignAndVerifyWithIssuerKeys",
      "Effect": "Allow",
      "Action": ["kms:Sign", "kms:Verify", "kms:GetPublicKey"],
      "Resource": [
        "arn:aws:kms:ap-southeast-1:ACCOUNT_ID:key/MSU_KEY_ID",
        "arn:aws:kms:ap-southeast-1:ACCOUNT_ID:key/NSU_KEY_ID"
      ]
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-1:ACCOUNT_ID:*"
    }
  ]
}
